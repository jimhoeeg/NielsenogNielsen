---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { investments, sectors } from '../../data/site';
---
<Base
  title="Portefølje – aktive og realiserede investeringer"
  description="Se porteføljen hos Nielsen & Nielsen: Micro Matic, Nielsen & Nielsen Ejendomme, børsnoterede værdipapirer og realiserede investeringer som Triax og Nassau Door."
>
  <PageHero
    eyebrow="Portefølje"
    title="Virksomheder vi har bygget og ejer"
    lead="Fra fadølsanlæg til boliger på Fyn. Her er de aktiver og virksomheder, der har formet familiernes historie."
    crumbs={[{ href: '/investeringer/', label: 'Investeringer' }, { label: 'Portefølje' }]}
  />

  <section class="section section--sand">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filtrér portefølje" data-reveal>
        <button class="chip is-active" data-filter="all" aria-pressed="true">Alle</button>
        <button class="chip" data-filter="status:Aktiv" aria-pressed="false">Aktive</button>
        <button class="chip" data-filter="status:Realiseret" aria-pressed="false">Realiserede</button>
        <span class="filters__sep" aria-hidden="true"></span>
        {sectors.map((s) => <button class="chip" data-filter={`sector:${s}`} aria-pressed="false">{s}</button>)}
      </div>
      <p class="sr-only" aria-live="polite" data-count-live></p>
      <div class="grid grid--3 pf-grid" data-grid>
        {investments.map((item, i) => <PortfolioCard item={item} d={i % 3} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px; align-items: center; }
  .filters__sep { width: 1px; height: 24px; background: var(--line); margin-inline: 6px; }
  .chip { font: 400 0.95rem var(--font); padding: 10px 20px; border-radius: var(--pill); border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; transition: all 0.25s; }
  .chip:hover { border-color: var(--ink); }
  .chip.is-active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .pf-grid :global(.pf) { transition: opacity 0.4s var(--ease), transform 0.5s var(--ease); }
  .pf-grid :global(.pf.is-hidden) { display: none !important; }
</style>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] .pf')];
  const live = document.querySelector<HTMLElement>('[data-count-live]')!;
  const apply = (filter: string) => {
    let n = 0;
    cards.forEach((c, i) => {
      const [k, v] = filter.split(':');
      const show = filter === 'all' || c.dataset[k] === v;
      c.classList.toggle('is-hidden', !show);
      if (show) {
        n++;
        c.animate([{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }], { duration: 500, delay: i * 50, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' });
      }
    });
    live.textContent = `Viser ${n} investeringer`;
  };
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => { c.classList.toggle('is-active', c === chip); c.setAttribute('aria-pressed', String(c === chip)); });
    apply(chip.dataset.filter!);
  }));
</script>
