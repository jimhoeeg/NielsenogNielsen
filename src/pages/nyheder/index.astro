---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NewsCard from '../../components/NewsCard.astro';
import Icon from '../../components/Icon.astro';
import { news, company } from '../../data/site';
const sorted = [...news].sort((a, b) => b.date.localeCompare(a.date));
---
<Base
  title="Nyheder og presse"
  description="Nyheder, pressemeddelelser og pressemateriale fra Nielsen & Nielsen Investments, Ejendomme og Micro Matic-familierne."
>
  <PageHero eyebrow="Nyheder" title="Nyheder og presse" lead="Følg med i, hvad der sker i Nielsen & Nielsen." crumbs={[{ label: 'Nyheder' }]} />
  <section class="section section--sand">
    <div class="wrap">
      <div class="grid grid--3">
        {sorted.map((n, i) => <NewsCard item={n} d={i % 3} />)}
      </div>
    </div>
  </section>
  <section class="section" id="presse">
    <div class="wrap press">
      <div>
        <p class="eyebrow" data-reveal>Presserum</p>
        <h2 data-reveal>Til journalister</h2>
        <p class="muted" data-reveal>Her finder du logoer, pressebilleder og faktaark. Har du spørgsmål, så kontakt os direkte.</p>
        <a class="link-arrow" href={`mailto:${company.email}`} data-reveal>{company.email}</a>
      </div>
      <ul class="downloads">
        <!-- TODO: læg rigtige filer i /public/presse/ -->
        <li data-reveal><a href="/favicon.svg" download="nielsen-nielsen-logo.svg"><Icon name="download" /> Logo (SVG)</a></li>
        <li data-reveal style="--d:1"><a href="/kort-om/"><Icon name="download" /> Faktaark</a></li>
        <li data-reveal style="--d:2"><a href="#" aria-disabled="true"><Icon name="download" /> Pressebilleder (kommer snart)</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .press { display: grid; gap: 48px; }
  @media (min-width: 900px) { .press { grid-template-columns: 1fr 1fr; align-items: center; } }
  .downloads { list-style: none; margin: 0; padding: 0; }
  .downloads a { display: flex; align-items: center; gap: 14px; padding: 22px 4px; border-top: 1px solid var(--line); text-decoration: none; font-size: 1.15rem; transition: color 0.2s, padding 0.3s var(--ease); }
  .downloads li:last-child a { border-bottom: 1px solid var(--line); }
  .downloads a:hover { color: var(--red); padding-left: 12px; }
  .downloads :global(svg) { color: var(--red); }
</style>
