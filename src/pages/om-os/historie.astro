---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import HistoryStory from '../../components/HistoryStory.astro';
import CtaBand from '../../components/CtaBand.astro';
import { timeline } from '../../data/site';
const crumbs = [{ href: '/om-os/', label: 'Om os' }, { label: 'Historie' }];
---
<Base
  title="Vores historie – fra 1953 til i dag"
  crumbs={crumbs}
  description="Tidslinje: fra Micro Matics grundlæggelse i 1953 og familiernes overtagelse i 1974 til stiftelsen af Nielsen & Nielsen Investments i 2024."
>
  <PageHero
    eyebrow="Historie"
    title="Mere end 70 års historie"
    lead="Scroll gennem de milepæle, der har formet familierne og virksomhederne."
    crumbs={crumbs}
  />
  <section class="section section--sand" aria-labelledby="story-h">
    <div class="wrap">
      <h2 id="story-h" class="sr-only">Tidslinje 1953 til i dag</h2>
      <HistoryStory items={timeline} />
    </div>
  </section>
  <CtaBand />
</Base>
