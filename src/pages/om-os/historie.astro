---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Timeline from '../../components/Timeline.astro';
import CtaBand from '../../components/CtaBand.astro';
import { timeline } from '../../data/site';
---
<Base
  title="Vores historie – fra 1953 til i dag"
  description="Tidslinje over Nielsen & Nielsen: fra Micro Matics grundlæggelse i 1953 og familiernes overtagelse i 1974 til stiftelsen af Nielsen & Nielsen Investments i 2024."
>
  <PageHero
    eyebrow="Historie"
    title="Mere end 70 års historie"
    lead="Scroll gennem de milepæle, der har formet familierne og virksomhederne."
    crumbs={[{ href: '/om-os/', label: 'Om os' }, { label: 'Historie' }]}
  />
  <section class="section section--sand">
    <div class="wrap wrap--narrow"><Timeline items={timeline} /></div>
  </section>
  <CtaBand />
</Base>
