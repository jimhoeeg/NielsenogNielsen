---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Split from '../../components/Split.astro';
import Visual from '../../components/Visual.astro';
import { url } from '../../lib/url';
import CtaBand from '../../components/CtaBand.astro';

// TODO: Strukturen er udledt af offentlige kilder og SKAL bekræftes af kunden før lancering.
const nodes = {
  famA: { title: 'Familien Svend-Aage Nielsen', text: 'Efterkommere af Svend-Aage Nielsen, der i 1974 var med til at overtage Micro Matic.' },
  famB: { title: 'Familien C.C. Nielsen', text: 'Efterkommere af Carl Christian Nielsen, der i 1974 var med til at overtage Micro Matic.' },
  saan: { title: 'SAAN Holding A/S', text: 'Holdingselskab for familien Svend-Aage Nielsen.' },
  ccn: { title: 'C.C.N. Holding A/S', text: 'Holdingselskab for familien C.C. Nielsen.' },
  mm: { title: 'Micro Matic A/S', text: 'Global industrikoncern inden for dispensering af drikkevarer. Hovedsæde i Odense.', href: '/micro-matic/' },
  grp: { title: 'Nielsen & Nielsen Gruppen A/S', text: 'Familiernes fælles gruppe, stiftet i 2024. Hver familie skød 112 mio. kr. ind. CVR 45150380.', href: '/om-os/' },
  inv: { title: 'Nielsen & Nielsen Investments A/S', text: 'Stiftet i 2024. Forvalter formuen i værdipapirer og udvalgte investeringer.', href: '/investeringer/' },
  ejd: { title: 'Nielsen & Nielsen Ejendomme A/S', text: 'Udvikler og driver lejeboliger på Fyn siden 1989.', href: '/ejendomme/' },
};

const crumbs = [{ href: '/om-os/', label: 'Om os' }, { label: 'Governance' }];
// Base-bevidste links til brug i klient-scriptet
for (const n of Object.values(nodes) as { href?: string }[]) if (n.href) n.href = url(n.href);

// TODO: navne og fotos godkendes af kunden
const people = [
  { name: 'Navn Efternavn', role: 'Bestyrelsesformand' },
  { name: 'Navn Efternavn', role: 'Bestyrelsesmedlem' },
  { name: 'Navn Efternavn', role: 'Bestyrelsesmedlem' },
  { name: 'Navn Efternavn', role: 'Administrerende direktør' },
];
---
<Base
  title="Ejerskab og governance"
  crumbs={crumbs}
  description="Se ejerstrukturen bag Nielsen & Nielsen: familierne, holdingselskaberne, Micro Matic, Nielsen & Nielsen Gruppen, Investments og Ejendomme."
>
  <PageHero
    eyebrow="Governance"
    title="Ejerskab og ledelse"
    lead="To familier ejer gruppen ligeligt gennem hver sit holdingselskab. Klik på et selskab i diagrammet for at læse mere."
    crumbs={crumbs}
  />

  <section class="section section--sand" aria-labelledby="org-h">
    <div class="wrap">
      <h2 id="org-h" class="sr-only">Ejerstruktur</h2>
      <figure class="org" data-org aria-describedby="org-note">
        <div class="org__row" data-reveal>
          <button class="node node--fam" data-node="famA">Familien Svend-Aage Nielsen</button>
          <button class="node node--fam" data-node="famB">Familien C.C. Nielsen</button>
        </div>
        <div class="org__link" aria-hidden="true"></div>
        <div class="org__row" data-reveal style="--d:1">
          <button class="node" data-node="saan">SAAN Holding A/S</button>
          <span class="org__share" aria-hidden="true">50 / 50</span>
          <button class="node" data-node="ccn">C.C.N. Holding A/S</button>
        </div>
        <div class="org__link" aria-hidden="true"></div>
        <div class="org__row org__row--3" data-reveal style="--d:2">
          <button class="node node--accent" data-node="mm">Micro Matic A/S</button>
          <div class="org__col">
            <button class="node node--red" data-node="grp">Nielsen &amp; Nielsen Gruppen A/S</button>
            <div class="org__link org__link--short" aria-hidden="true"></div>
            <button class="node node--accent" data-node="inv">Nielsen &amp; Nielsen Investments A/S</button>
          </div>
          <button class="node node--accent" data-node="ejd">Nielsen &amp; Nielsen Ejendomme A/S</button>
        </div>
        <div class="org__panel card" aria-live="polite" data-panel>
          <h3 data-panel-title>{nodes.grp.title}</h3>
          <p class="muted" data-panel-text>{nodes.grp.text}</p>
          <a class="link-arrow" href={nodes.grp.href} data-panel-link>Læs mere</a>
        </div>
        <figcaption class="org__note muted" id="org-note">Forenklet illustration. Strukturen er under afklaring.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Bestyrelse &amp; ledelse</p>
      <Split text="Menneskene bag" />
      <div class="grid people" style="margin-top:40px">
        {people.map((p, i) => (
          <figure class="person" data-reveal style={`--d:${i}`}>
            <Visual kind="people" class="person__img" />
            <figcaption><strong>{p.name}</strong><span class="muted">{p.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script define:vars={{ nodes }}>
  const panel = document.querySelector('[data-panel]');
  const t = panel.querySelector('[data-panel-title]');
  const p = panel.querySelector('[data-panel-text]');
  const a = panel.querySelector('[data-panel-link]');
  const buttons = document.querySelectorAll('[data-node]');
  const select = (key) => {
    const n = nodes[key];
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.node === key)));
    panel.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 400, easing: 'ease-out' });
    t.textContent = n.title;
    p.textContent = n.text;
    a.hidden = !n.href;
    if (n.href) a.href = n.href;
  };
  buttons.forEach((b) => b.addEventListener('click', () => select(b.dataset.node)));
  select('grp');
</script>

<style>
  .org { display: grid; justify-items: center; gap: 0; margin: 0; }
  .org__row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: clamp(12px, 3vw, 40px); width: 100%; }
  .org__row--3 { align-items: flex-start; }
  .org__col { display: grid; justify-items: center; }
  .org__link { width: 2px; height: 36px; background: var(--ink); opacity: 0.25; }
  .org__link--short { height: 22px; }
  .org__share { font-size: 0.85rem; font-weight: 500; color: var(--red); letter-spacing: 0.1em; }
  .node {
    font: 400 1rem/1.3 var(--font); color: var(--ink); background: #fff; border: 1px solid var(--line);
    border-radius: 14px; padding: 16px 22px; min-width: 220px; cursor: pointer; transition: all 0.3s var(--ease);
  }
  .node:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -18px rgba(21, 24, 37, 0.35); }
  .node--fam { background: transparent; border-style: dashed; }
  .node--accent { border-color: var(--ink); }
  .node--red { background: var(--red); color: #fff; border-color: var(--red); }
  .node[aria-pressed='true'] { outline: 3px solid var(--red); outline-offset: 3px; }
  .org__panel { margin-top: 40px; width: min(100%, 640px); text-align: center; }
  .org__panel h3 { font-weight: 500; }
  .org__note { margin: 16px 0 1.1em; font-size: 0.85rem; }
  .people { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .person { margin: 0; }
  :global(.person__img) { aspect-ratio: 4 / 5; margin-bottom: 14px; }
  .person figcaption { display: grid; }
</style>
