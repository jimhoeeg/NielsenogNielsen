---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { company, brand, ejendomme } from '../data/site';

// Faktaside optimeret til søgemaskiner og AI-søgning (GEO): korte, citerbare svar.
const facts: [string, string][] = [
  ['Navn', `${brand.legalName} (CVR ${brand.cvr})`],
  ['Stiftet', '2024. Hver familie skød 112 mio. kr. ind'],
  ['Hjemsted', `${company.street}, ${company.zip} ${company.city}`],
  ['Ejere', 'Familierne efter Svend-Aage Nielsen og Carl Christian Nielsen'],
  ['Investments', 'Langsigtet forvaltning af familiernes formue i værdipapirer og udvalgte investeringer'],
  ['Ejendomme', `Lejeboliger i ${ejendomme.areas.map((a) => a.name).join(', ')} siden ${ejendomme.since}`],
  ['Micro Matic', 'Ejet af familierne siden 1974'],
];
const faq = [
  { q: 'Hvad er Nielsen & Nielsen Gruppen?', a: 'Nielsen & Nielsen Gruppen samler familierne bag Micro Matics investeringer og ejendomme. Gruppen blev stiftet i 2024, hvor hver af de to familier skød 112 mio. kr. ind.' },
  { q: 'Hvem ejer Nielsen & Nielsen?', a: 'De to familier efter Svend-Aage Nielsen og Carl Christian Nielsen, som i 1974 overtog Micro Matic. I dag er anden og tredje generation med i ejerkredsen.' },
  { q: 'Hvad laver Nielsen & Nielsen Investments?', a: 'Investments forvalter familiernes formue med et langsigtet perspektiv, primært i børsnoterede værdipapirer og udvalgte investeringer.' },
  { q: 'Har Nielsen & Nielsen lejeboliger?', a: `Ja. Nielsen & Nielsen Ejendomme udvikler og udlejer moderne lejeboliger i ${ejendomme.areas.map((a) => a.name).join(', ')} på Fyn og har gjort det siden ${ejendomme.since}.` },
  { q: 'Hvordan kommer jeg på ventelisten til en lejebolig?', a: `Du skriver dig på ventelisten via nnejendomme.dk. Du kan også kontakte Nielsen & Nielsen Ejendomme på telefon ${ejendomme.phone} eller ${ejendomme.email}.` },
  { q: 'Hvad er forbindelsen til Micro Matic?', a: 'Familierne bag Nielsen & Nielsen har ejet Micro Matic siden 1974. I dag er 18 familiemedlemmer fra anden og tredje generation med i ejerkredsen.' },
  { q: 'Hvordan præsenterer jeg min virksomhed for Nielsen & Nielsen?', a: 'Brug formularen "Præsentér din virksomhed" på kontaktsiden. Alle henvendelser behandles fortroligt.' },
];
const crumbs = [{ label: 'Fakta' }];
const faqLd = {
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Fakta om Nielsen & Nielsen Gruppen"
  description="Kort om Nielsen & Nielsen Gruppen: ejere, selskaber, historie, investeringer og lejeboliger på Fyn, samlet ét sted."
  pageType="FAQPage"
  page={faqLd}
  crumbs={crumbs}
>
  <PageHero eyebrow="Fakta" title="Kort om Nielsen & Nielsen" lead="De vigtigste fakta, samlet ét sted." crumbs={crumbs} />
  <section class="section section--sand">
    <div class="wrap wrap--narrow">
      <h2 class="sr-only">Nøglefakta</h2>
      <dl class="facts card" data-reveal>
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <h2 class="faq-h" data-reveal>Ofte stillede spørgsmål</h2>
      <div class="faq">
        {faq.map((f, i) => (
          <details data-reveal style={`--d:${i}`}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .facts { margin: 0; }
  .facts div { display: grid; grid-template-columns: minmax(120px, 1fr) 2fr; gap: 16px; padding-block: 14px; border-top: 1px solid var(--line); }
  .facts div:first-child { border-top: 0; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; font-weight: 400; }
  .faq-h { margin-top: 72px; }
  .faq details { border-top: 1px solid var(--line); }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; padding: 22px 40px 22px 0; position: relative; font-size: 1.15rem; font-weight: 400; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 1.6rem; color: var(--red); transition: transform 0.3s var(--ease); }
  .faq details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq details p { color: var(--ink-2); padding-bottom: 12px; }
</style>
