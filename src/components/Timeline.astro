---
// Interaktiv tidslinje: linjen tegnes, mens man scroller, og hvert punkt flyder ind.
interface Item { year: string; title: string; text: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ol class="tl" data-timeline>
  <span class="tl__line" aria-hidden="true"><span class="tl__fill"></span></span>
  {items.map((it, i) => (
    <li class:list={['tl__item', { 'tl__item--right': i % 2 === 1 }]} data-reveal={i % 2 ? 'right' : 'left'}>
      <span class="tl__dot" aria-hidden="true"></span>
      <div class="tl__card">
        <span class="tl__year">{it.year}</span>
        <h3>{it.title}</h3>
        <p>{it.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .tl { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(24px, 4vw, 48px); }
  .tl__line { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; background: var(--line); transform: translateX(-1px); }
  .tl__fill { position: absolute; inset: 0; background: var(--red); transform-origin: top; transform: scaleY(var(--tl, 0)); }
  .tl__item { position: relative; width: 50%; padding-right: clamp(32px, 5vw, 72px); }
  .tl__item--right { margin-left: 50%; padding-right: 0; padding-left: clamp(32px, 5vw, 72px); }
  .tl__dot { position: absolute; top: 14px; right: -9px; width: 18px; height: 18px; border-radius: 50% 50% 0 50%; background: var(--red); box-shadow: 0 0 0 6px #fff; }
  .tl__item--right .tl__dot { right: auto; left: -9px; border-radius: 0 50% 50% 50%; }
  .tl__card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(20px, 2.5vw, 32px); }
  .tl__year { display: block; font-size: clamp(2rem, 1.5rem + 2vw, 3rem); font-weight: 300; color: var(--red); line-height: 1; margin-bottom: 12px; letter-spacing: -0.02em; }
  .tl__card h3 { font-size: 1.25rem; font-weight: 500; }
  .tl__card p { margin: 0; color: var(--ink-2); }
  @media (max-width: 760px) {
    .tl__line { left: 8px; }
    .tl__item, .tl__item--right { width: auto; margin-left: 0; padding: 0 0 0 40px; }
    .tl__dot, .tl__item--right .tl__dot { left: 0; right: auto; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((tl) => {
    const update = () => {
      const r = tl.getBoundingClientRect();
      const p = (window.innerHeight * 0.6 - r.top) / r.height;
      tl.style.setProperty('--tl', String(Math.max(0, Math.min(1, p))));
    };
    window.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    update();
  });
</script>
