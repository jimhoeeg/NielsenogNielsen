---
// Dekorative brand-illustrationer i logoets formsprog (dråber/cirkler).
// TODO: suppleres/erstattes med rigtige fotos fra fotodag (familie, Fyn, fabrik, boligområder).
interface Props { kind: 'investments' | 'ejendomme' | 'micromatic' | 'history' | 'people'; class?: string }
const { kind, class: cls = '' } = Astro.props;
---
<div class:list={['visual', `visual--${kind}`, cls]} aria-hidden="true" data-reveal="fade">
  {kind === 'investments' && (
    <svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="260" fill="#f7f4f1" />
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <rect class="bar" x={40 + i * 48} y={200 - (30 + i * i * 3.2 + (i % 2) * 10)} width="26" height={30 + i * i * 3.2 + (i % 2) * 10} rx="13" fill={i === 6 ? '#df331e' : '#151825'} opacity={i === 6 ? 1 : 0.12 + i * 0.08} style={`--i:${i}`} />
      ))}
      <path d="M40 210 H360" stroke="#151825" stroke-opacity=".15" />
    </svg>
  )}
  {kind === 'ejendomme' && (
    <svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="260" fill="#f7f4f1" />
      <circle cx="320" cy="70" r="34" fill="#df331e" class="sun" />
      <g fill="#151825">
        <path d="M30 200 L90 150 L150 200 V230 H30Z" opacity=".85" />
        <path d="M140 200 L200 140 L260 200 V230 H140Z" />
        <path d="M250 200 L310 155 L370 200 V230 H250Z" opacity=".7" />
      </g>
      <g fill="#f7f4f1">
        <rect x="75" y="200" width="20" height="30" rx="2" />
        <rect x="185" y="195" width="30" height="20" rx="2" />
        <rect x="296" y="200" width="20" height="30" rx="2" />
      </g>
      <path d="M0 230 H400" stroke="#df331e" stroke-width="4" />
    </svg>
  )}
  {kind === 'micromatic' && (
    <svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="260" fill="#151825" />
      <g class="bubbles" fill="#df331e">
        <circle cx="120" cy="190" r="10" />
        <circle cx="160" cy="150" r="16" opacity=".8" />
        <circle cx="210" cy="110" r="24" opacity=".6" />
        <circle cx="275" cy="80" r="36" opacity=".9" />
        <circle cx="90" cy="120" r="6" opacity=".5" />
        <circle cx="330" cy="170" r="12" opacity=".5" />
      </g>
      <path d="M40 230 H360" stroke="#fff" stroke-opacity=".2" />
    </svg>
  )}
  {kind === 'history' && (
    <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="400" fill="#f7f4f1" />
      <path d="M80 140A60 60 0 0 1 200 140V200H140A60 60 0 0 1 80 140Z" fill="#df331e" />
      <path d="M200 200H260A60 60 0 1 1 200 260Z" fill="#df331e" />
      <text x="200" y="350" text-anchor="middle" font-family="Roboto, Arial" font-size="40" font-weight="300" fill="#151825">1974</text>
    </svg>
  )}
  {kind === 'people' && (
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="#f7f4f1" />
      <g fill="#151825" opacity=".85">
        <circle cx="140" cy="120" r="34" /><path d="M80 260a60 60 0 0 1 120 0Z" />
        <circle cx="260" cy="120" r="34" /><path d="M200 260a60 60 0 0 1 120 0Z" />
      </g>
      <circle cx="200" cy="80" r="14" fill="#df331e" />
    </svg>
  )}
</div>

<style>
  .visual { overflow: hidden; border-radius: var(--radius); background: var(--sand); }
  .visual svg { width: 100%; height: 100%; }
  .bar { transform-box: fill-box; transform-origin: bottom; }
  :global(.js) .bar { transform: scaleY(0); transition: transform 1.1s var(--ease); transition-delay: calc(var(--i) * 80ms + 300ms); }
  .visual.is-visible .bar { transform: none; }
  .bubbles circle { animation: rise 6s ease-in-out infinite alternate; }
  .bubbles circle:nth-child(2n) { animation-duration: 8s; }
  .sun { animation: pulse 5s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: reduce) { .bar { transform: none !important; } }
  @keyframes rise { to { transform: translateY(-14px); } }
  @keyframes pulse { to { transform: scale(1.12); } }
</style>
