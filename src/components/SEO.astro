---
import { company } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang: 'da' | 'en';
  altHref?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, lang, altHref, image = '/og-image.png', type = 'website', jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = title.includes('Nielsen & Nielsen') ? title : `${title} | Nielsen & Nielsen Investments`;

const orgId = new URL('/#organization', site).href;
const graph = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: company.name,
    legalName: company.legalName,
    url: site.href,
    logo: new URL('/favicon.svg', site).href,
    foundingDate: String(company.founded),
    email: company.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.street,
      postalCode: company.zip,
      addressLocality: company.city.replace(' SV', ''),
      addressCountry: company.country,
    },
    parentOrganization: { '@type': 'Organization', name: company.groupName, identifier: `CVR ${company.groupCvr}` },
    sameAs: [company.linkedin],
    subOrganization: [
      { '@type': 'Organization', name: 'Nielsen & Nielsen Ejendomme A/S', url: 'https://nnejendomme.dk/' },
    ],
    knowsAbout: ['Langsigtet investering', 'Familieejet kapital', 'Aktivt ejerskab', 'Ejendomme'],
  },
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    url: site.href,
    name: 'Nielsen & Nielsen',
    inLanguage: ['da-DK', 'en-GB'],
    publisher: { '@id': orgId },
  },
  ...jsonLd,
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{altHref && (
  <>
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'da' ? 'en' : 'da'} href={new URL(altHref, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(lang === 'da' ? Astro.url.pathname : altHref, site).href} />
  </>
)}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Nielsen & Nielsen" />
<meta property="og:locale" content={lang === 'da' ? 'da_DK' : 'en_GB'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={ld} />
