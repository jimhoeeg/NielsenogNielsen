---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormScript from '../components/FormScript.astro';
import type { Crumb, PageType } from '../components/SEO.astro';
// Preload af de to skriftsnit, der bruges i toppen af siden (brødtekst 300, overskrifter 400) – forbedrer LCP.
import roboto300 from '@fontsource/roboto/files/roboto-latin-300-normal.woff2?url';
import roboto400 from '@fontsource/roboto/files/roboto-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  lang?: 'da' | 'en';
  altHref?: string;
  type?: 'website' | 'article';
  pageType?: PageType;
  page?: Record<string, unknown>;
  crumbs?: Crumb[];
  published?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { lang = 'da', altHref, ...seo } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#df331e" />
    <link rel="preload" href={roboto300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={roboto400} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SEO lang={lang} altHref={altHref} {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : 'Gå til indhold'}</a>
    <Header lang={lang} altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <FormScript />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Scroll-reveal: elementer flyder ind, når de kommer i view
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal], [data-split]').forEach((el) => io.observe(el));

      // 2) Tællere der tæller op
      const fmt = new Intl.NumberFormat(document.documentElement.lang === 'en' ? 'en-GB' : 'da-DK');
      const countIO = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            countIO.unobserve(el);
            const to = Number(el.dataset.count);
            const plain = el.dataset.plain !== undefined;
            const show = (n: number) => (el.textContent = plain ? String(n) : fmt.format(n));
            if (reduce) { show(to); continue; }
            const from = plain ? Math.max(0, to - 60) : 0;
            const dur = 1800;
            const t0 = performance.now();
            const tick = (t: number) => {
              const p = Math.min(1, (t - t0) / dur);
              const eased = 1 - Math.pow(1 - p, 4);
              show(Math.round(from + (to - from) * eased));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.6 },
      );
      document.querySelectorAll('[data-count]').forEach((el) => countIO.observe(el));

      // 3) Let parallax på dekorative elementer
      const px = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      if (px.length && !reduce) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          for (const el of px) {
            const r = el.parentElement!.getBoundingClientRect();
            if (r.bottom < 0 || r.top > vh) continue;
            const progress = (r.top + r.height / 2 - vh / 2) / vh;
            el.style.translate = `0 ${progress * Number(el.dataset.parallax) * -100}px`;
          }
          ticking = false;
        };
        window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        update();
      }
    </script>
  </body>
</html>
